    <bpmn:userTask id="Activity_0fmkox7" name="заполнить форму с деталями поездки" camunda:formKey="embedded:deployment:travel-form.html" camunda:assignee="demo">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy">println "┌─────────────────────────────────────────";
println "│ FORM DATA RECEIVED";

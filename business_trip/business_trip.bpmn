    <bpmn:serviceTask id="Activity_17z025s" name="рассчитать сумму командировочных расходов" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy">// Получаем данные из формы
        def destination = execution.getVariable("destination");
        def tripDays = execution.getVariable("tripDays");
        def employeeCount = execution.getVariable("employeeCount");
        
        // Получаем ставку из БД (установлена в предыдущем шаге)
        def dailyRate = execution.getVariable("dailyRate");
        // Если ставка не установлена, используем дефолт
        if (dailyRate == null) {
            dailyRate = 5000;
            execution.setVariable("dailyRate", dailyRate);
        }

        // Рассчитываем общую сумму
        def travelsum = 0;
        if (tripDays != null &amp;&amp; employeeCount != null) {
            travelsum = tripDays * employeeCount * dailyRate;
        }

        // Сохраняем переменную для шлюза
        execution.setVariable("travelsum", travelsum);
        execution.setVariable("dailyRate", dailyRate);

        println "┌─────────────────────────────────────────";
        println "│ CALCULATING TRAVEL EXPENSES";
        println "├─────────────────────────────────────────";
        println "│ Город:           " + (destination ?: "Не указано");
        println "│ Количество дней: " + (tripDays ?: "Не указано");
        println "│ Число работников:" + (employeeCount ?: "Не указано");
        println "│ Ставка:          " + dailyRate + " руб./день/чел.";
        println "├─────────────────────────────────────────";
        println "│ ИТОГО:           " + travelsum + " RUB";
        println "│ (свыше 50 000 руб. - требуется фин.директор)";
        println "└─────────────────────────────────────────";

        println "service task completed: calculate the amount of travel expenses";</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1v331ow</bpmn:incoming>
      <bpmn:outgoing>Flow_12lfzhn</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_12w96kd" name="получить ставку из БД" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy">import java.sql.DriverManager;
        import java.sql.Statement;
        import java.sql.ResultSet;

        println "┌─────────────────────────────────────────";
        println "│ GETTING DAILY RATE FROM DATABASE";
        println "├─────────────────────────────────────────";

        def destination = execution.getVariable("destination");

        // Настройки подключения к H2
        def dbUrl = "jdbc:h2:~/camunda/city_rates;DB_CLOSE_DELAY=-1"
        def dbUser = "sa"
        def dbPassword = ""

        def dailyRate = null

        try {
            // Загружаем драйвер H2
            Class.forName("org.h2.Driver")

            // Подключаемся к БД
            def conn = DriverManager.getConnection(dbUrl, dbUser, dbPassword)

            // Создаем таблицу если не существует
            def createTableSQL = """
                CREATE TABLE IF NOT EXISTS city_rates (
                    id INT PRIMARY KEY AUTO_INCREMENT,
                    city_name VARCHAR(255) NOT NULL UNIQUE,
                    daily_rate INT NOT NULL,
                    currency VARCHAR(10) DEFAULT 'RUB'
                )
            """
            def stmt = conn.createStatement()
            stmt.execute(createTableSQL)
            stmt.close()

            // Проверяем есть ли данные
            def checkStmt = conn.createStatement()
            def rs = checkStmt.executeQuery("SELECT COUNT(*) as cnt FROM city_rates")
            rs.next()
            def count = rs.getInt("cnt")
            checkStmt.close()

            if (count == 0) {
                // Вставляем начальные данные
                def insertStmt = conn.prepareStatement("INSERT INTO city_rates (city_name, daily_rate) VALUES (?, ?)")
                def cities = [
                    ["Москва", 5500],
                    ["Санкт-Петербург", 5000],
                    ["Казань", 4500],
                    ["Новосибирск", 4200],
                    ["Екатеринбург", 4000],
                    ["Краснодар", 3800],
                    ["Сочи", 4500],
                    ["Владивосток", 4800],
                    ["Ростов-на-Дону", 3700],
                    ["Тюмень", 4100],
                    ["Нижний Новгород", 3900],
                    ["Самара", 3800],
                    ["Уфа", 3700],
                    ["Омск", 3600],
                    ["Челябинск", 3700],
                    ["Красноярск", 4000],
                    ["Пермь", 3600],
                    ["Волгоград", 3500]
                ]

                cities.each { city, rate -&gt;
                    insertStmt.setString(1, city)
                    insertStmt.setInt(2, rate)
                    insertStmt.addBatch()
                }
                insertStmt.executeBatch()
                insertStmt.close()

                println "│ [INIT] Inserted " + cities.size() + " cities into database";
            }

            // Получаем ставку для города
            def rateStmt = conn.prepareStatement("SELECT daily_rate FROM city_rates WHERE city_name = ?")
            rateStmt.setString(1, destination)
            def rateRs = rateStmt.executeQuery()

            if (rateRs.next()) {
                dailyRate = rateRs.getInt("daily_rate")
                println "│ Город:           " + destination;
                println "│ Ставка:          " + dailyRate + " руб./день/чел.";
            } else {
                println "│ [WARNING] Ставка для города '" + destination + "' не найдена";
                println "│ Используется ставка по умолчанию: 5000 руб.";
                dailyRate = 5000
            }

            rateRs.close()
            rateStmt.close()
            conn.close()

        } catch (Exception e) {
            println "│ [ERROR] " + e.getMessage();
            // Используем дефолтную ставку
            dailyRate = 5000
            println "│ Используется ставка по умолчанию: 5000 руб.";
        }

        // Сохраняем ставку
        execution.setVariable("dailyRate", dailyRate);
        execution.setVariable("currency", "RUB");

        println "└─────────────────────────────────────────";
        println "service task completed: get daily rate from DB";</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>

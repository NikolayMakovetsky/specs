    <bpmn:serviceTask id="Activity_0ii94cd" name="сформировать txt-документ" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy">import java.text.SimpleDateFormat
import java.text.DecimalFormat

println "┌─────────────────────────────────────────";
println "│ GENERATING TRAVEL DOCUMENT";
println "├─────────────────────────────────────────";

// Получаем данные
def destination = execution.getVariable("destination");
def tripDays = execution.getVariable("tripDays");
def employeeCount = execution.getVariable("employeeCount");
def dailyRate = execution.getVariable("dailyRate");
def travelsum = execution.getVariable("travelsum");
def date = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss").format(new Date());

// Форматируем сумму с разделителями тысяч
def decimalFormat = new DecimalFormat("#,###")
def formattedTravelsum = travelsum != null ? decimalFormat.format(travelsum) : "Не указано"

// Формируем статус согласования
def approvalStatus = "  ✅ Требуется утверждение бухгалтера"
if (travelsum &gt;= 50000) {
    approvalStatus = approvalStatus + "\n  ✅ Требуется утверждение финансового директора"
}

// Создаем контент документа (без ID процесса)
def documentContent = """
========================================================
              СЛУЖЕБНАЯ ЗАПИСКА
              о служебной командировке
========================================================

Город назначения:          ${destination ?: "Не указано"}
Количество дней:           ${tripDays ?: "Не указано"}
Количество работников:     ${employeeCount ?: "Не указано"}
Ставка (руб./день/чел.):   ${dailyRate ?: "Не указано"}

--------------------------------------------------------
ИТОГО:                     ${formattedTravelsum} RUB
--------------------------------------------------------

Статус согласования:
${approvalStatus}

========================================================
СОГЛАСОВАНО:

Бухгалтер:                   ___________________
                             (Иванова М.А.)
${travelsum &gt;= 50000 ? '''

Финансовый директор:          ___________________
                             (Сидоров В.П.)
''' : ''}
========================================================
Дата создания документа: ${date}
========================================================
""".trim()

// Формируем имя файла
def dateFormat = new SimpleDateFormat("yyyy-MM-dd_HH-mm-ss")
def timestamp = dateFormat.format(new Date())
def cleanCity = destination ? destination.replaceAll("[^a-zA-Zа-яА-Я]", "_") : "unknown"
def fileName = "travel_document_" + timestamp + "_" + cleanCity + ".txt"

// Путь к папке проекта
def projectDir = "D:/Projects/specs/business_trip"
def docsDir = projectDir + "/documents"
def filePath = docsDir + "/" + fileName

// Создаем папку если не существует
def dir = new File(docsDir)
if (!dir.exists()) {
    dir.mkdirs()
    println "│ [INFO] Создана папка: " + docsDir;
}

// Сохраняем файл
def file = new File(filePath)
file.text = documentContent

println "│ [OK] Документ создан: " + filePath;
println "│ Сумма: " + (travelsum != null ? formattedTravelsum : "Не указано") + " RUB";

// Сохраняем путь к документу в переменные
execution.setVariable("documentPath", filePath);
execution.setVariable("documentName", fileName);

println "└─────────────────────────────────────────";
println "service task completed: generate PDF document";</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>

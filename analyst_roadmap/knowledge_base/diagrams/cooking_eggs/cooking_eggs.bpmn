    <bpmn:textAnnotation id="TextAnnotation_02db4pi">
      <bpmn:text>Тостовый хлеб - 2 шт.
Бекон - 60 г.
Сыр творожный - 2 ст.л.
Яйцо куриное - 2 шт.
Масло растительное - 1 ст.л.
Лист салата - 2 г.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_16ufdmn">
      <bpmn:text>сковороду можно не мыть</bpmn:text>
    </bpmn:textAnnotation>

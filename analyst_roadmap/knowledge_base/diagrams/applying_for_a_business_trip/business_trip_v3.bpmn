    <bpmn:scriptTask id="Activity_1ns73ne" name="проверить бюджет департамента" scriptFormat="groovy">
      <bpmn:incoming>Flow_1ka9la9</bpmn:incoming>
      <bpmn:outgoing>Flow_11c1qde</bpmn:outgoing>
      <bpmn:script>// Budget check stub
    println "=== Budget Department Check ==="
    def cost = execution.getVariable("tripCost")
    if (cost == null) {
      execution.setVariable("tripCost", 5000)
      println "Test value set: tripCost = 5000 (path: YES)"
    } else {
      println "Trip cost: " + cost
      if (cost &lt; 10000) {
        println "Path: YES (cost &lt; 10000)"
      } else {
        println "Path: NO (cost &gt;= 10000)"
      }
    }
    println "=== Check completed ==="</bpmn:script>
    </bpmn:scriptTask>
  </bpmn:process>

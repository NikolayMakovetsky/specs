  <bpmn:collaboration id="Collaboration_0m1mp40">
    <bpmn:participant id="Participant_09tajte" name="Согласование командировки" processRef="Process_122q1w7" />
  </bpmn:collaboration>
  <bpmn:process id="Process_122q1w7" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="StartEvent_1" name="руководитель отдела запланировал командировку сотрудников">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="groovy">println "======================================"
        println "Process started: Business trip approval"
        println "sStart time: " + new Date().format("yyyy-MM-dd HH:mm:ss")
        println "Process instance ID: " + execution.getProcessInstanceId()
println "------------------------------"</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_0e7r8h7</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_0fmkox7" name="заполнить форму с деталями поездки" camunda:assignee="demo">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy">println "user task completed: fill travel form"</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0e7r8h7</bpmn:incoming>
      <bpmn:outgoing>Flow_03ylu4f</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_17z025s" name="рассчитать сумму командировочных расходов" camunda:expression="${true}">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy">println "service task completed: calculate the amount of travel expenses"</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03ylu4f</bpmn:incoming>
      <bpmn:outgoing>Flow_12c6n5b</bpmn:outgoing>

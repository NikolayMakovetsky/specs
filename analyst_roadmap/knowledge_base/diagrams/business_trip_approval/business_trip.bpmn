    <bpmn:dataObject id="DataObject_1lu1elx" />
    <bpmn:sequenceFlow id="Flow_0e7r8h7" sourceRef="StartEvent_1" targetRef="Activity_0fmkox7" />
    <bpmn:sequenceFlow id="Flow_03ylu4f" sourceRef="Activity_0fmkox7" targetRef="Activity_17z025s" />
    <bpmn:userTask id="Activity_0638qsz" name="утвердить документ у бухгалтера" camunda:assignee="demo">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy">println "user task completed: approve the document from the accountant"</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0afvfgy</bpmn:incoming>
      <bpmn:outgoing>Flow_0qwncjz</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_0rqozjy" name="сумма расходов tripsum &#62;= 50.000">
      <bpmn:incoming>Flow_0qwncjz</bpmn:incoming>
      <bpmn:outgoing>Flow_038g0qp</bpmn:outgoing>
      <bpmn:outgoing>Flow_18iy0a0</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_0n8alms" name="утвердить документ у финансового директора" camunda:assignee="demo">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy">println "user task completed: approve the document from the finance director"</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_038g0qp</bpmn:incoming>
      <bpmn:outgoing>Flow_1ewuvy4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_0wgtu8v" name="командировка согласована">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy">println "------------------------------"
        println "Process completed: Business trip approval"
        println "End time: " + new Date().format("yyyy-MM-dd HH:mm:ss")
        println "Process instance ID: " + execution.getProcessInstanceId()
        println "======================================"</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ewuvy4</bpmn:incoming>
      <bpmn:incoming>Flow_18iy0a0</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0qwncjz" sourceRef="Activity_0638qsz" targetRef="Gateway_0rqozjy" />
    <bpmn:sequenceFlow id="Flow_038g0qp" name="да" sourceRef="Gateway_0rqozjy" targetRef="Activity_0n8alms">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${tripsum &gt;= 50000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18iy0a0" name="нет" sourceRef="Gateway_0rqozjy" targetRef="Event_0wgtu8v">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${tripsum &lt; 50000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1ewuvy4" sourceRef="Activity_0n8alms" targetRef="Event_0wgtu8v" />
    <bpmn:sequenceFlow id="Flow_12c6n5b" sourceRef="Activity_17z025s" targetRef="Activity_000sdbb" />
    <bpmn:sequenceFlow id="Flow_0afvfgy" sourceRef="Activity_000sdbb" targetRef="Activity_0638qsz" />
    <bpmn:scriptTask id="Activity_000sdbb" name="установить значение переменной tripsum" scriptFormat="groovy">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="groovy">def tripsum = execution.getVariable("tripsum");
println "script task completed: set tripsum value (tripsum = " + tripsum + ")";</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_12c6n5b</bpmn:incoming>
      <bpmn:outgoing>Flow_0afvfgy</bpmn:outgoing>
      <bpmn:script>def tripsumValue = 60000;
execution.setVariable("tripsum", tripsumValue);</bpmn:script>
    </bpmn:scriptTask>
  </bpmn:process>

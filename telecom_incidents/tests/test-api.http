### ============================================
### TTM Lite — Тестирование API
### ============================================

### Переменные (можно менять под свои нужды)
@baseUrl = http://localhost:8081/api
@taskId = TASK-1786723304716-776

### ============================================
### 1. Создать инцидент
### ============================================

POST {{baseUrl}}/incidents
Content-Type: application/json

{
    "clientName": "Тестовый клиент",
    "serviceType": "Интернет",
    "problemType": "Клиентская",
    "macroSegment": "B2B",
    "address": "г. Москва, ул. Тестовая, д. 1"
}

### ============================================
### 2. Получить список инцидентов
### ============================================

GET {{baseUrl}}/incidents

### ============================================
### 3. Получить инцидент по ID
### ============================================

GET {{baseUrl}}/incidents/1

### ============================================
### 4. Получить список заданий
### ============================================

GET {{baseUrl}}/tasks

### ============================================
### 5. Получить задание по ID
### ============================================

GET {{baseUrl}}/tasks/{{taskId}}

### ============================================
### 6. Получить правила для задания
### ============================================
### Вместо TASK-xxx подставьте реальный ID задания
### Например: TASK-1786723304716-776

GET {{baseUrl}}/tasks/{{taskId}}/rules

### ============================================
### 7. Завершить задание (Problem Resolved)
### ============================================
### Использует правило 14527 (Problem Resolved)
### Вместо TASK-xxx подставьте реальный ID задания

POST {{baseUrl}}/tasks/{{taskId}}/complete
Content-Type: application/json

{
    "ruleId": 14527,
    "comment": "Проблема решена"
}

### ============================================
### 8. Завершить задание (No Answer from Client)
### ============================================
### Использует правило 14529 (No Answer from Client)
### Вместо TASK-xxx подставьте реальный ID задания

POST {{baseUrl}}/tasks/{{taskId}}/complete
Content-Type: application/json

{
    "ruleId": 14529,
    "comment": "Недозвон до клиента"
}

### ============================================
### 9. Завершить задание (Escalate to 2LTP)
### ============================================
### Использует правило 14526 (Escalate to 2LTP)
### Вместо TASK-xxx подставьте реальный ID задания

POST {{baseUrl}}/tasks/{{taskId}}/complete
Content-Type: application/json

{
    "ruleId": 14526,
    "comment": "Эскалация на 2LTP"
}

### ============================================
### 10. Завершить задание (Requires MRF Check)
### ============================================
### Использует правило 14525 (Requires MRF Check)
### Вместо TASK-xxx подставьте реальный ID задания

POST {{baseUrl}}/tasks/{{taskId}}/complete
Content-Type: application/json

{
    "ruleId": 14525,
    "comment": "Требуется проверка МРФ"
}

### ============================================
### 11. Завершить задание (GEP Request)
### ============================================
### Использует правило 14528 (GEP Request)
### Вместо TASK-xxx подставьте реальный ID задания

POST {{baseUrl}}/tasks/{{taskId}}/complete
Content-Type: application/json

{
    "ruleId": 14528,
    "comment": "Запрос в ГЭП"
}

### ============================================
### 12. Проверить здоровье системы
### ============================================

GET {{baseUrl}}/health